{
  "description": "Example configuration for Lovense API integration",
  "note": "Copy this file to config.json and fill in your actual values. Never commit config.json to version control!",

  "lovense": {
    "developer_token": "YOUR_DEVELOPER_TOKEN_HERE",
    "user_id": "YOUR_USER_ID_HERE",
    "callback_url": "https://your-server.example.com/lovense/callback"
  },

  "middleware": {
    "server_url": "https://your-server.example.com/lovense/command",
    "port": 3000,
    "enable_https": true,
    "ssl_cert_path": "/path/to/ssl/cert.pem",
    "ssl_key_path": "/path/to/ssl/key.pem"
  },

  "lan_api": {
    "enabled": false,
    "local_ip": "192.168.1.100",
    "https_port": 30010,
    "note": "Get these values from Lovense Connect app Settings → Developer"
  },

  "security": {
    "allowed_users": [
      "SecondLife Avatar UUID here",
      "Another UUID here"
    ],
    "owner_only": true,
    "require_consent": true,
    "max_intensity": 20,
    "default_duration_seconds": 10,
    "enable_emergency_stop": true
  },

  "rate_limiting": {
    "enabled": true,
    "max_requests_per_minute": 60,
    "max_requests_per_second": 2,
    "cooldown_ms": 500
  },

  "logging": {
    "enabled": true,
    "log_requests": true,
    "log_responses": true,
    "log_errors": true,
    "log_file_path": "/var/log/lovense-middleware.log"
  },

  "defaults": {
    "vibrate_intensity_low": 5,
    "vibrate_intensity_medium": 10,
    "vibrate_intensity_high": 20,
    "default_pattern_duration": 10,
    "api_version": 1
  },

  "advanced": {
    "timeout_ms": 10000,
    "retry_attempts": 3,
    "retry_delay_ms": 1000,
    "verify_ssl": true,
    "enable_websocket": false,
    "websocket_port": 8080
  }
}
